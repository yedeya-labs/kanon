{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["actions", "cli", "infra", "scripts", "tests", "*.config.ts", "*.config.js"],
  // The pipeline library's tests were moved from the reference adopter, which does not check
  // indexed access, so they are checked without it in tsconfig.library.json (ADR 0009).
  "exclude": ["tests/library"]
}
